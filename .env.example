# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qidirect_mall
DB_USER=root
DB_PASSWORD=root

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=mallredis

# JWT（至少 32 字节，生产必须替换）
JWT_SECRET=qidirect-mall-dev-secret-please-change-32chars

# 敏感数据加密（AES 密钥必须为 16/24/32 字节，生产必须替换）
AES_KEY=qidirect-mall-aes-key-32-bytes!!
HASH_SALT=qidirect-mall-hash-salt

# 邀请注册落地页
INVITE_BASE_URL=https://mall.example.com/register

# 扫呗支付
SAOBEI_MERCHANT_NO=
SAOBEI_TERMINAL_ID=
SAOBEI_ACCESS_TOKEN=
SAOBEI_API_BASE=
SAOBEI_SERVICE_ID=
SAOBEI_NOTIFY_URL=https://mall.example.com/api/notify/saobei

# 微信公众号
WX_APPID=
WX_SECRET=
WX_BRIDGE_URL=https://mall.example.com/pay-bridge

# 短信
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN=
SMS_TEMPLATE_CODE=

# 文件存储：local / oss
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=/files
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET=
OSS_PUBLIC_URL=
